# Copy this file to .env (same folder) and fill in your values. .env is never committed to git.

# MongoDB Atlas connection string: replace <password> with the database user's password.
# Leave empty to keep everything in the local SQLite file (~/.vlsi_toolkit/history.db).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional)
MONGODB_DB=vlsi_toolkit
